+def get_chrome_major_version(chrome_path=None):
+    """Detect the installed Chrome major version to pass to undetected_chromedriver."""
+    if platform.system() == "Windows":
+        try:
+            import winreg
+            for root in (winreg.HKEY_CURRENT_USER, winreg.HKEY_LOCAL_MACHINE):
+                try:
+                    key = winreg.OpenKey(root, r"Software\Google\Chrome\BLBeacon")
+                    ver, _ = winreg.QueryValueEx(key, "version")
+                    return int(ver.split(".")[0])
+                except Exception:
+                    pass
+        except Exception:
+            pass
+    targets = [chrome_path] if chrome_path else ["google-chrome", "chromium", "chrome"]
+    for t in targets:
+        if not t:
+            continue
+        try:
+            out = subprocess.check_output([t, "--version"], stderr=subprocess.DEVNULL, text=True)
+            m = re.search(r"(\d+)\.", out)
+            if m:
+                return int(m.group(1))
+        except Exception:
+            pass
+    return None
 
